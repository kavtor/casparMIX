+std::vector<std::wstring> producer_args(const std::wstring& spec)
+{
+    std::wistringstream stream(spec);
+    std::vector<std::wstring> result;
+    while (stream >> std::ws && stream.peek() != std::char_traits<wchar_t>::eof()) {
+        std::wstring token;
+        if (stream.peek() == L'"')
+            stream >> std::quoted(token);
+        else
+            stream >> token;
+        if (!stream)
+            CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid quoted DME producer"));
+        result.push_back(std::move(token));
+    }
+    if (result.empty())
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Empty DME producer"));
+    return result;
+}
