+// Sony random catalogue patterns are distinct from Dust Mix. Fixed cell seeds
+// and progress-only evaluation make held frames and rewinds reproducible.
+float sony_random_distance(vec2 p,float progress) {
+    vec2 size=max(dust_size,vec2(.001));
+    vec2 uv=vec2(p.x*sony_output_aspect,p.y)/size;
+    vec2 cell=floor(uv),local=fract(uv)-vec2(.5);
+    float seed=dust_hash(cell,0.0);
+    if(sony_code==273) {
+        // Volatility changes the rate of generation, never a wall-clock seed.
+        float rate=exp2((dust_flash-50.0)/50.0);
+        float threshold=pow(progress,1.0/rate);
+        vec2 edge=(vec2(.5)-abs(local))*size;
+        float distance=min(edge.x,edge.y);
+        return seed<=threshold?distance:-min(size.x,size.y);
+    }
+    float start=seed*.8*dust_flash/100.0;
+    float radius=clamp((progress-start)/(1.0-start),0.0,1.0);
+    // An L1 contour produces actual diamonds, including their tips. Equal
+    // physical sizes produce equal-width/height particles on every output.
+    return (radius-abs(local.x)-abs(local.y))*min(size.x,size.y)*.707106781;
+}
