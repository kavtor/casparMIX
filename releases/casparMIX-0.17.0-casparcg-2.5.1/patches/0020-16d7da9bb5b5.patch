+std::wstring background_spec(const std::wstring& hex)
+{
+    if (hex.empty() || hex.size() > 8192 || hex.size() % 2)
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME background payload"));
+    auto digit = [](wchar_t c) {
+        if (c >= L'0' && c <= L'9')
+            return int(c - L'0');
+        if (c >= L'a' && c <= L'f')
+            return int(c - L'a' + 10);
+        if (c >= L'A' && c <= L'F')
+            return int(c - L'A' + 10);
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME background hex"));
+    };
+    std::string value;
+    for (size_t i = 0; i < hex.size(); i += 2)
+        value.push_back(char((digit(hex[i]) << 4) | digit(hex[i + 1])));
+    if (value.find_first_of("\r\n") != std::string::npos || value.find('\0') != std::string::npos)
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME background producer"));
+    return u16(value);
+}
