diff --git a/src/core/frame/page_geometry.h b/src/core/frame/page_geometry.h
new file mode 100644
index 0000000000000000000000000000000000000000..8b4edf00145ca5cbab1b788b10d1b9619a1be02e
--- /dev/null
+++ b/src/core/frame/page_geometry.h
@@ -0,0 +1,83 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <core/frame/frame_transform.h>
+#include <core/frame/geometry.h>
+#include <vector>
+
+namespace caspar::core {
+struct page_quad
+{
+    std::vector<core::frame_geometry::coord> coords;
+    double                                   depth = 0;
+};
+inline std::vector<page_quad> page_mesh(const std::vector<core::frame_geometry::coord>& texture,
+                                        const core::page_surface&                       surface)
+{
+    if (texture.size() != 4 || (surface.mode != 1 && surface.mode != 2) || !std::isfinite(surface.progress) ||
+        !std::isfinite(surface.radius))
+        return {};
+    constexpr double       pi = 3.14159265358979323846, camera = 3., sqrt2 = 1.4142135623730951;
+    const bool             corner = surface.mode == 1;
+    const int              nx = corner ? 24 : 48, ny = corner ? 24 : 1;
+    const double           radius = std::clamp(surface.radius, .03, .4), p = std::clamp(surface.progress, 0., 1.);
+    const double           extent   = corner ? sqrt2 : 1.;
+    const double           boundary = extent - p * (extent + (corner ? pi * radius : radius));
+    std::vector<page_quad> result;
+    result.reserve(nx * ny);
+    const auto angle_at = [&](double d) {
+        return d <= boundary ? 0 : corner ? std::min((d - boundary) / radius, pi) : (d - boundary) / radius;
+    };
+    const auto tex = [&](double u, double v, bool y) {
+        auto get = [y](const auto& c) { return y ? c.texture_y : c.texture_x; };
+        return (1 - v) * (get(texture[0]) + (get(texture[1]) - get(texture[0])) * u) +
+               v * (get(texture[3]) + (get(texture[2]) - get(texture[3])) * u);
+    };
+    for (int j = 0; j < ny; ++j)
+        for (int i = 0; i < nx; ++i) {
+            const double lo = double(i) / nx, hi = double(i + 1) / nx, top = double(j) / ny,
+                         bottom = double(j + 1) / ny;
+            page_quad    face;
+            face.coords.reserve(4);
+            const double us[] = {lo, hi, hi, lo}, vs[] = {top, top, bottom, bottom};
+            for (int k = 0; k < 4; ++k) {
+                const double u = us[k], v = vs[k], d = corner ? (u + v) / sqrt2 : u,
+                             tangent = corner ? (v - u) / sqrt2 : v;
+                double       bent = d, z = 0;
+                if (d > boundary) {
+                    const double raw = (d - boundary) / radius;
+                    if (corner && raw > pi) {
+                        bent = boundary - (d - boundary - pi * radius);
+                        z    = 2 * radius;
+                    } else {
+                        bent = boundary + radius * std::sin(raw);
+                        z    = radius * (1 - std::cos(raw));
+                    }
+                }
+                double       x = corner ? (bent - tangent) / sqrt2 : bent, y = corner ? (bent + tangent) / sqrt2 : v;
+                const double projection = camera / (camera - z);
+                x                       = .5 + (x - .5) * projection;
+                y                       = .5 + (y - .5) * projection;
+                if (surface.reverse)
+                    x = 1 - x;
+                const double                sample = surface.reverse ? 1 - u : u;
+                core::frame_geometry::coord c(x, y, tex(sample, v, false), tex(sample, v, true));
+                const double                normal = std::cos(angle_at(d));
+                c.texture_r                        = (normal < 0 ? -1 : 1) * (.6 + .4 * std::abs(normal));
+                face.coords.push_back(c);
+                face.depth += z / 4;
+            }
+            double area = 0;
+            for (int n = 0; n < 4; ++n) {
+                const auto& a = face.coords[n];
+                const auto& b = face.coords[(n + 1) % 4];
+                area += a.vertex_x * b.vertex_y - b.vertex_x * a.vertex_y;
+            }
+            if (std::abs(area) < 1e-10)
+                continue; // Edge-on quads have no finite texture homography.
+            result.push_back(std::move(face));
+        }
+    std::stable_sort(result.begin(), result.end(), [](const auto& a, const auto& b) { return a.depth < b.depth; });
+    return result;
+}
+} // namespace caspar::core
