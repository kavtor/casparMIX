@@ -527,17 +527,20 @@ uniform float sony_progress;
 uniform float sony_soft;
 uniform float sony_border;
 uniform float sony_aspect;
+uniform float sony_output_aspect;
 uniform int sony_multi;
 uniform vec2 sony_center;
 uniform bool sony_reverse;
 
-float sony_distance(vec2 p, float t)
+float sony_distance(vec2 p, float t, float cell_aspect)
 {
     vec2 q = p - sony_center;
     vec2 extent = max(sony_center, vec2(1.0) - sony_center);
     float ar = max(sony_aspect, 0.01);
-    q.x /= ar;
-    extent.x /= ar;
+    // Distances are measured in cell-height units, not normalized screen X/Y.
+    // At neutral ASPECT the iris remains round/square in displayed pixels.
+    q.x *= cell_aspect / ar;
+    extent.x *= cell_aspect / ar;
     if (sony_code == 1) return t - p.x;
     if (sony_code == 3) return t - p.y;
     if (sony_code == 5) return t - max(p.x, p.y);
@@ -552,7 +555,9 @@ float sony_distance(vec2 p, float t)
 
 float sony_coverage(float distance, float softness)
 {
-    return softness > 0.0 ? smoothstep(-softness, softness, distance) : step(0.0, distance);
+    // One pixel of geometric antialiasing also applies to a hard edge.
+    float width = max(softness, max(0.5*fwidth(distance), 0.0000001));
+    return smoothstep(-width, width, distance);
 }
 
