index 0000000000000000000000000000000000000000..583a68b9ab0ca13bd6378c6f3ffd16f8808887f7
--- /dev/null
+++ b/src/core/frame_sync_group.cpp
@@ -0,0 +1,129 @@
+/*
+ * Copyright (c) 2026 casparMIX contributors.
+ *
+ * This file is part of CasparCG (www.casparcg.com).
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "StdAfx.h"
+#include "frame_sync_group.h"
+#include <common/except.h>
+#include <common/log.h>
+#include <common/os/thread.h>
+#include <chrono>
+#include <set>
+
+namespace caspar::core {
+
+std::vector<int> frame_sync_group::order_locked() const
+{
+    std::vector<int> result;
+    std::set<int> done;
+    while (result.size() < members_.size()) {
+        bool advanced = false;
+        for (const auto& member : members_) {
+            if (done.count(member.first)) continue;
+            bool ready = true;
+            for (const auto& edge : edges_)
+                if (edge.second && edge.first.second == member.first && !done.count(edge.first.first))
+                    ready = false;
+            if (ready) {
+                done.insert(member.first);
+                result.push_back(member.first);
+                advanced = true;
+            }
+        }
+        if (!advanced)
+            CASPAR_THROW_EXCEPTION(user_error() << msg_info("Frame synchronization routes must be acyclic"));
+    }
+    return result;
+}
+
+void frame_sync_group::add(int channel, const video_format_desc& format, std::function<void(uint64_t)> render)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (thread_.joinable() || stopped_)
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info("Cannot add channels to a running synchronization group"));
+    if (format.field_count != 1 || (!members_.empty() &&
+        (format.framerate.numerator() != numerator_ || format.framerate.denominator() != denominator_)))
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info("Synchronization groups require matching progressive frame rates"));
+    numerator_ = format.framerate.numerator();
+    denominator_ = format.framerate.denominator();
+    members_.emplace(channel, std::move(render));
+}
+
+std::shared_ptr<void> frame_sync_group::dependency(int source, int destination)
+{
+    if (source == destination) return {};
+    const auto key = std::make_pair(source, destination);
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!members_.count(source) || !members_.count(destination))
+            CASPAR_THROW_EXCEPTION(user_error() << msg_info("Route endpoints must belong to the same synchronization group"));
+        ++edges_[key];
+        try { order_locked(); }
+        catch (...) { if (!--edges_[key]) edges_.erase(key); throw; }
+    }
+    const auto weak = weak_from_this();
+    return std::shared_ptr<void>(new int(0), [weak, key](void* p) {
+        delete static_cast<int*>(p);
+        if (auto self = weak.lock()) {
+            std::lock_guard<std::mutex> lock(self->mutex_);
+            auto edge = self->edges_.find(key);
+            if (edge != self->edges_.end() && !--edge->second) self->edges_.erase(edge);
+        }
+    });
+}
+
+void frame_sync_group::start()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (members_.empty() || thread_.joinable() || stopped_) return;
+    thread_ = std::thread([this] {
+        using clock = std::chrono::steady_clock;
+        set_thread_name(L"frame-sync");
+        set_thread_realtime_priority();
+        auto origin = clock::now();
+        uint64_t tick = 0;
+        while (true) {
+            std::vector<std::function<void(uint64_t)>> work;
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                if (stopped_) break;
+                for (int id : order_locked()) work.push_back(members_.at(id));
+            }
+            epoch_.store(++tick, std::memory_order_release);
+            for (auto& render : work) render(tick);
+            // Derive deadlines from a rational rate, not rounded per-frame sleeps.
+            auto deadline = origin + std::chrono::duration_cast<clock::duration>(
+                std::chrono::duration<double>(double(tick) * denominator_ / numerator_));
+            // If rendering falls more than one frame behind, rebase the wall
+            // clock instead of issuing an unbounded burst of catch-up frames.
+            // Epochs remain sequential; overload lowers output rate.
+            const auto now = clock::now();
+            const auto period = std::chrono::duration_cast<clock::duration>(
+                std::chrono::duration<double>(double(denominator_) / numerator_));
+            if (now > deadline + period) {
+                origin += now - deadline;
+                deadline = now;
+            }
+            std::unique_lock<std::mutex> lock(mutex_);
+            if (wake_.wait_until(lock, deadline, [this] { return stopped_; })) break;
+        }
+    });
+}
+
+void frame_sync_group::stop()
+{
+    { std::lock_guard<std::mutex> lock(mutex_); stopped_ = true; }
+    wake_.notify_all();
+    if (thread_.joinable()) thread_.join();
+}
+void frame_sync_group::remove(int channel)
+{
+    stop(); // No callback may still refer to a channel being destroyed.
+    std::lock_guard<std::mutex> lock(mutex_);
+    members_.erase(channel);
+}
+frame_sync_group::~frame_sync_group() { stop(); }
+}
diff --git a/src/core/frame_sync_group.h b/src/core/frame_sync_group.h
new file mode 100644
index 0000000000000000000000000000000000000000..47f6fbf6b3b62c591005b41eaa4c2438d5c077fb
--- /dev/null
+++ b/src/core/frame_sync_group.h
@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2026 casparMIX contributors.
+ *
+ * This file is part of CasparCG (www.casparcg.com).
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include "video_format.h"
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace caspar::core {
+
+// Opt-in progressive software-clock domain. Dependencies determine evaluation
+// order; every member advances once per epoch, including consumer-free sources.
+class frame_sync_group : public std::enable_shared_from_this<frame_sync_group>
+{
+    std::mutex mutex_;
+    std::condition_variable wake_;
+    std::map<int, std::function<void(uint64_t)>> members_;
+    std::map<std::pair<int, int>, unsigned> edges_;
+    std::atomic<uint64_t> epoch_{0};
+    std::thread thread_;
+    bool stopped_ = false;
+    int numerator_ = 0;
+    int denominator_ = 1;
+    std::vector<int> order_locked() const;
+
+public:
+    ~frame_sync_group();
+    void add(int channel, const video_format_desc& format, std::function<void(uint64_t)> render);
+    void remove(int channel);
+    std::shared_ptr<void> dependency(int source, int destination);
+    uint64_t epoch() const { return epoch_.load(std::memory_order_acquire); }
+    void start();
+    void stop();
+};
+}
