@@ -583,6 +583,15 @@ float sony_angular(vec2 q,float start,float sweep) {
     float d=min(length(q-first*max(dot(q,first),0.0)),length(q-last*max(dot(q,last),0.0)));
     return angle<=sweep?d:-d;
 }
+// Symmetric opening fan. The signed distance to its two rays keeps SOFT
+// and BORDER on the same geometry, including the pivot.
+float sony_fan(vec2 q,float direction,float half_width) {
+    float angle=mod(atan(q.x,-q.y)-direction+3.141592654,6.283185307)-3.141592654;
+    vec2 first=vec2(sin(direction-half_width),-cos(direction-half_width));
+    vec2 last=vec2(sin(direction+half_width),-cos(direction+half_width));
+    float distance=min(length(q-first*max(dot(q,first),0.0)),length(q-last*max(dot(q,last),0.0)));
+    return abs(angle)<=half_width?distance:-distance;
+}
 float sony_distance(vec2 p, float t, float cell_aspect)
 {
     vec2 q=p-sony_center,extent=max(sony_center,vec2(1)-sony_center);
@@ -646,6 +655,34 @@ float sony_distance(vec2 p, float t, float cell_aspect)
         return length(point)*sin(edge-angle);
     }
     if(sony_code>=104&&sony_code<=107)return sony_angular(vec2(q.x*raster/ar,q.y),float(sony_code-104)*1.570796327,t*6.283185307);
+    if(sony_code==150||sony_code==151||sony_code==604||sony_code==606){
+        vec2 pivot=sony_center;float direction=0.0;
+        if(sony_code==150){pivot.x+=.5;direction=4.712388980;}
+        else if(sony_code==151){pivot.x-=.5;direction=1.570796327;}
+        else if(sony_code==604){pivot.y+=.5;direction=0.0;}
+        else {pivot.y-=.5;direction=3.141592654;}
+        vec2 point=p-pivot;point.x*=raster/ar;
+        return -sony_fan(point,direction,(1-t)*1.570796327);
+    }
+    if(sony_code==156||sony_code==624)
+        return sony_fan(vec2(q.x*raster/ar,q.y),sony_code==156?0.0:4.712388980,t*3.141592654);
+    if(sony_code==661){
+        vec2 point=vec2(q.x*raster/ar,q.y);
+        return max(sony_fan(point,1.570796327,t*1.570796327),sony_fan(point,4.712388980,t*1.570796327));
+    }
+    if(sony_code==158||sony_code==160||sony_code==162){
+        int blades=sony_code==162?4:2;float step=6.283185307/float(blades);
+        float start=sony_code==160?1.570796327:0.0;float distance=-1e10;
+        for(int blade=0;blade<4;++blade){if(blade>=blades)break;
+            distance=max(distance,sony_angular(vec2(q.x*raster/ar,q.y),start+float(blade)*step,t*step));}
+        return distance;
+    }
+    if(sony_code==516||sony_code==518){
+        vec2 pivot=sony_center; pivot.y+=sony_code==516?-.5:.5;
+        vec2 point=p-pivot;point.x*=raster/ar;
+        if(sony_code==516)point.y=-point.y;
+        return sony_angular(point,4.712388980,t*3.141592654);
+    }
     return -1.0;
 }
 
