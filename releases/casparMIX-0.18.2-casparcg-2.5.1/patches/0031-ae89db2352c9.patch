+// Project a live video plane around its centre, using physical raster units.
+// Camera distance and scale curves are project defaults, not measured Sony data.
+void project_sony_plane(draw_frame& frame,bool vertical,double angle,double scale,double aspect) {
+    auto& x=frame.transform().image_transform;x.enable_geometry_modifiers=true;
+    std::array<double,2>* corners[]={&x.perspective.ul,&x.perspective.ur,&x.perspective.lr,&x.perspective.ll};
+    const double xs[]={0,1,1,0},ys[]={0,0,1,1},camera=3.5;
+    double cosine=std::cos(angle);if(std::abs(cosine)<1e-6)cosine=1e-6;
+    if(std::abs(std::cos(angle))<1e-6)x.opacity=0;
+    for(int i=0;i<4;++i){double px=(xs[i]-.5)*aspect*scale,py=(ys[i]-.5)*scale;
+        double z=vertical?-px*std::sin(angle):py*std::sin(angle);
+        if(vertical)px*=cosine;else py*=cosine;
+        double projection=camera/(camera-z);*corners[i]={.5+px*projection/aspect,.5+py*projection};
+    }
