+// Both matte halves are evaluated from the same frame transform. The colour
+// border occupies the gap between the two softened boundaries.
+uniform int sony_code;
+uniform int sony_role;
+uniform float sony_progress;
+uniform float sony_soft;
+uniform float sony_border;
+uniform float sony_aspect;
+uniform int sony_multi;
+uniform vec2 sony_center;
+uniform bool sony_reverse;
+
+float sony_distance(vec2 p, float t)
+{
+    vec2 q = p - sony_center;
+    vec2 extent = max(sony_center, vec2(1.0) - sony_center);
+    float ar = max(sony_aspect, 0.01);
+    q.x /= ar;
+    extent.x /= ar;
+    if (sony_code == 1) return t - p.x;
+    if (sony_code == 3) return t - p.y;
+    if (sony_code == 5) return t - max(p.x, p.y);
+    if (sony_code == 6) return t - max(1.0-p.x, p.y);
+    if (sony_code == 9) return (2.0*t-p.x-p.y) / sqrt(2.0);
+    if (sony_code == 17) return t*extent.x - abs(q.x);
+    if (sony_code == 18) return t*extent.y - abs(q.y);
+    if (sony_code == 21) return t*max(extent.x, extent.y)-max(abs(q.x),abs(q.y));
+    if (sony_code == 23) return (t*(extent.x+extent.y)-abs(q.x)-abs(q.y))/sqrt(2.0);
+    return t*length(extent)-length(q); // Sony 24: circular/elliptical iris
+}
+
+float sony_coverage(float distance, float softness)
+{
+    return softness > 0.0 ? smoothstep(-softness, softness, distance) : step(0.0, distance);
+}
+
+float sony_matte(vec2 packed_uv)
+{
+    bool outgoing = packed_uv.x >= 0.5;
+    vec2 p = sony_role == 0 ? vec2(fract(packed_uv.x*2.0), packed_uv.y) : packed_uv;
+    vec2 grid = vec2(1.0);
+    if (sony_multi > 1) {
+        if (sony_code == 1 || sony_code == 17) grid.x = float(sony_multi);
+        else if (sony_code == 3 || sony_code == 18) grid.y = float(sony_multi);
+        else if (sony_multi == 2) grid.x = 2.0;
+        else grid = vec2(ceil(sqrt(float(sony_multi))));
+    }
+    p = fract(p*grid);
+    float t = clamp(sony_progress, 0.0, 1.0);
+    if (t <= 0.0) return sony_role != 0 ? 0.0 : outgoing ? 1.0 : 0.0;
+    if (t >= 1.0) return sony_role == 2 ? 0.0 : sony_role == 1 ? 1.0 : outgoing ? 0.0 : 1.0;
+    float d = sony_distance(p, sony_reverse ? 1.0-t : t);
+    if (sony_reverse) d = -d;
+    if (sony_role == 1) return sony_coverage(d, sony_soft);
+    float inner = sony_coverage(d-sony_border, sony_soft);
+    float outer = sony_coverage(d+sony_border, sony_soft);
+    if (sony_role == 2) return clamp(outer-inner, 0.0, 1.0);
+    return outgoing ? (inner >= 1.0 ? 0.0 : clamp((1.0-outer)/(1.0-inner),0.0,1.0)) : inner;
+}
