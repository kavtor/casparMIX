+std::future<std::wstring> mixer_alpha_key_command(command_context& ctx)
+{
+    if(ctx.parameters.empty()) {
+        auto current=get_current_transform(ctx).share();
+        return std::async(std::launch::deferred,[current](){const auto a=current.get().image_transform.alpha;
+            std::wstring result=L"201 MIXER OK\r\n"+std::to_wstring(a.mode)+L" "+std::to_wstring(a.low)+L" "+std::to_wstring(a.high)+L" "+std::to_wstring(a.invert)+L" "+std::to_wstring(a.mask)+L" "+std::to_wstring(a.mask_invert);
+            for(double v:a.rectangle)result+=L" "+std::to_wstring(v);return result+L"\r\n";});
+    }
+    if(ctx.parameters.size()!=10)CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"ALPHAKEY expects mode, low, high, invert, mask, mask-invert, left, top, right, bottom"));
+    core::alpha_key a;const auto mode=boost::to_upper_copy(ctx.parameters[0]);
+    if(mode==L"OFF")a.mode=0;else if(mode==L"LINEAR")a.mode=1;else if(mode==L"LUMA")a.mode=2;else CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Invalid alpha key mode"));
+    auto number=[&](int i){size_t used=0;double v=std::stod(ctx.parameters[i],&used);if(used!=ctx.parameters[i].size()||!std::isfinite(v)||v<0||v>1)CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Invalid alpha key number"));return v;};
+    auto flag=[&](int i){if(ctx.parameters[i]!=L"0"&&ctx.parameters[i]!=L"1")CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Invalid alpha key flag"));return ctx.parameters[i]==L"1";};
+    a.low=number(1);a.high=number(2);a.invert=flag(3);a.mask=flag(4);a.mask_invert=flag(5);for(int i=0;i<4;++i)a.rectangle[i]=number(6+i);
+    if(a.low>=a.high||a.rectangle[0]>=a.rectangle[2]||a.rectangle[1]>=a.rectangle[3])CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Invalid alpha key range or rectangle"));
+    transforms_applier transforms(ctx);transforms.add(stage::transform_tuple_t(ctx.layer_index(),[a](frame_transform t){t.image_transform.alpha=a;return t;},0,tweener(L"linear")));transforms.apply();
+    return make_ready_future<std::wstring>(L"202 MIXER OK\r\n");
+}
