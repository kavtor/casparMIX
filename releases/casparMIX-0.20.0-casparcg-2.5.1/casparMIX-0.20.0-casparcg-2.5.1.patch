+            progress_ = duration_ == 1 ? 1 : std::min(1., double(current_) / double(duration_ - 1));
+        auto out = source_->receive(field, samples), in = destination_->receive(field, samples);
+        if (!out)
+            out = source_->last_frame(field);
+        if (!in)
+            in = destination_->last_frame(field);
