+        // bar boundaries. Keep legal-range samples and the source color matrix;
+        // the normal mixer performs the same conversion as any camera input.
+        // Legacy mixer paths infer BT.601 for small YUV rasters. Convert the
+        // RP 219 pattern explicitly when used at SD/thumbnail resolutions.
+        const bool rgb = pattern == L"SMPTEHD" && deps.format_desc.height <= 700;
+        const std::string tail = rgb
+            ? ",format=pix_fmts=yuv444p,scale=in_color_matrix=bt709:in_range=tv:out_range=pc,format=pix_fmts=bgra,buffersink"
+            : ",format=pix_fmts=yuv444p,buffersink";
+        const std::string spec = filter + "=size=" + std::to_string(deps.format_desc.width) + "x" +
+            std::to_string(deps.format_desc.height) + ":rate=1" + tail;
+        check(avfilter_graph_parse_ptr(graph.get(), spec.c_str(), nullptr, nullptr, nullptr));
+        check(avfilter_graph_config(graph.get(), nullptr));
+        AVFilterContext* sink = nullptr;
+        for (unsigned i = 0; i < graph->nb_filters; ++i)
+            if (std::strcmp(graph->filters[i]->filter->name, "buffersink") == 0) sink = graph->filters[i];
+        if (!sink) CASPAR_THROW_EXCEPTION(user_error() << msg_info("Color-bar filter has no output"));
+        check(av_buffersink_get_frame(sink, video.get()));
+        core::pixel_format_desc desc(rgb ? core::pixel_format::bgra : core::pixel_format::ycbcr,
+            pattern == L"SMPTEHD" ? core::color_space::bt709 : core::color_space::bt601);
+        const int planes = rgb ? 1 : 3;
+        const int stride = rgb ? 4 : 1;
+        for (int i = 0; i < planes; ++i)
+            desc.planes.emplace_back(video->width, video->height, stride);
+        auto image = deps.frame_factory->create_frame(this, desc);
+        for (int plane = 0; plane < planes; ++plane)
+            for (int y = 0; y < video->height; ++y)
+                std::memcpy(image.image_data(plane).begin() + y * video->width * stride,
+                            video->data[plane] + y * video->linesize[plane], video->width * stride);
+        frame_ = core::draw_frame(std::move(image));
+    }
+    core::draw_frame receive_impl(core::video_field, int) override { return frame_; }
+    bool is_ready() override { return true; }
+    std::wstring name() const override { return L"colorbars"; }
+    std::wstring print() const override { return L"colorbars[" + pattern_ + L"]"; }
+    core::monitor::state state() const override
+    {
+        core::monitor::state result;
+        result["colorbars/pattern"] = pattern_;
+        result["colorbars/static"] = true;
+        return result;
+    }
+};
+}
+spl::shared_ptr<core::frame_producer> create_color_bars_producer(
+    const core::frame_producer_dependencies& deps, const std::vector<std::wstring>& params)
+{
+    if (params.empty() || !boost::iequals(params[0], L"COLORBARS")) return core::frame_producer::empty();
+    const auto pattern = params.size() > 1 ? boost::to_upper_copy(params[1]) : std::wstring(L"EBU75");
+    const std::map<std::wstring, std::string> filters = {
+        {L"EBU75", "pal75bars"}, {L"EBU100", "pal100bars"},
+        {L"SMPTESD", "smptebars"}, {L"SMPTEHD", "smptehdbars"}};
+    auto it = filters.find(pattern);
+    if (it == filters.end())
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info("Unknown COLORBARS pattern: EBU75, EBU100, SMPTESD, SMPTEHD"));
+    return spl::make_shared<color_bars_producer>(deps, pattern, it->second);
+}
+}
