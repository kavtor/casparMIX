+public:
+    color_bars_producer(const core::frame_producer_dependencies& deps,
+                        const std::wstring& pattern, const std::string& filter)
+        : pattern_(pattern)
+    {
+        auto graph = std::unique_ptr<AVFilterGraph, void(*)(AVFilterGraph*)>(avfilter_graph_alloc(),
+            [](AVFilterGraph* p) { avfilter_graph_free(&p); });
+        auto video = std::unique_ptr<AVFrame, void(*)(AVFrame*)>(av_frame_alloc(),
