+        code = L"501";
+    }
+    try {
+        cmd->SendReply(code + L" " + cmd->name() + L" FAILED\r\n", reply_without_req_id);
+    } catch (...) {
+        CASPAR_LOG_CURRENT_EXCEPTION();
+    }
+    return false;
