+        code = L"404";
+    } catch (expected_user_error&) {
+        code = L"403";
+    } catch (user_error&) {
+        code = L"403";
+    } catch (std::out_of_range&) {
+        code = L"402";
+    } catch (boost::bad_lexical_cast&) {
+        code = L"403";
