+        if (progress_ > 0 && progress_ < 1) {
+            if (effect_ == L"MOVE") {
+                std::vector<std::pair<double, draw_frame>> layers;
+                for (auto& track : tracks_) {
+                    auto raw = track.producer->receive(field, samples);
+                    if (!raw)
+                        raw = track.producer->last_frame(field);
+                    auto frame = draw_frame::push(raw);
+                    auto p     = interpolate(track.from, track.to, progress_);
+                    apply(frame, p);
+                    layers.emplace_back(p.order, std::move(frame));
+                }
+                std::stable_sort(layers.begin(), layers.end(), [](auto& a, auto& b) { return a.first < b.first; });
+                for (auto& layer : layers)
+                    result = draw_frame::over(result, layer.second);
+            } else {
+                out = draw_frame::push(out);
+                in  = draw_frame::push(in);
+                out.transform().audio_transform.volume *= 1 - progress_;
+                in.transform().audio_transform.volume *= progress_;
+                if(effect_==L"NAM"||effect_==L"SUPER_MIX"){
+                    const double a=effect_==L"NAM"?1:gain_a_,b=effect_==L"NAM"?1:gain_b_;
+                    out.transform().image_transform.opacity*=progress_<=.5?1+(a-1)*2*progress_:a*2*(1-progress_);
+                    in.transform().image_transform.opacity*=progress_<=.5?b*2*progress_:b+(1-b)*2*(progress_-.5);
+                    // Blend modes belong to sibling rendered layers. Without
+                    // explicit depths, the stage groups both items into one
+                    // normal layer and cannot compare their complete signals.
+                    ++out.transform().image_transform.layer_depth;
+                    ++in.transform().image_transform.layer_depth;
+                    in.transform().image_transform.blend_mode=effect_==L"NAM"?blend_mode::nam:blend_mode::super_mix;
+                    result=draw_frame::over(out,in);
+                }
+                else if(sony_code_){result=sony_primitive_frame(sony_code_,out,in,progress_,reverse_,double(deps_.format_desc.square_width)/deps_.format_desc.square_height);}
+                else if (effect_ == L"PAGE_CURL" || effect_ == L"PAGE_ROLL") {
+                    auto& surface    = (effect_ == L"PAGE_ROLL" ? in : out).transform().image_transform.surface;
+                    surface.mode     = effect_ == L"PAGE_CURL" ? 1 : 2;
+                    surface.progress = effect_ == L"PAGE_ROLL" ? 1 - progress_ : progress_;
+                    surface.reverse  = effect_ == L"PAGE_ROLL" ? !reverse_ : reverse_;
+                    result           = effect_ == L"PAGE_ROLL" ? draw_frame::over(out, in) : draw_frame::over(in, out);
+                } else if (effect_.find(L"PUSH_") == 0 || effect_.find(L"SLIDE_") == 0) {
+                    const bool   push           = effect_.find(L"PUSH_") == 0;
+                    const auto   dir            = effect_.substr(push ? 5 : 6);
+                    const bool   vertical       = dir == L"TOP" || dir == L"BOTTOM";
+                    const double sign           = dir == L"RIGHT" || dir == L"BOTTOM" ? 1 : -1;
+                    auto&        a              = out.transform().image_transform;
+                    auto&        b              = in.transform().image_transform;
+                    a.enable_geometry_modifiers = b.enable_geometry_modifiers = true;
+                    if (push)
+                        a.fill_translation[vertical ? 1 : 0] = -sign * progress_;
+                    b.fill_translation[vertical ? 1 : 0] = sign * (1 - progress_);
+                    result                               = draw_frame::over(out, in);
+                } else if (effect_ == L"CUBE") {
+                    out.transform().image_transform.enable_geometry_modifiers = true;
+                    in.transform().image_transform.enable_geometry_modifiers  = true;
+                    out.transform().image_transform.perspective =
+                        cube_face((reverse_ ? 1 : -1) * progress_ * 1.5707963267948966, false, reverse_);
+                    in.transform().image_transform.perspective =
+                        cube_face((reverse_ ? 1 : -1) * progress_ * 1.5707963267948966, true, reverse_);
+                    result = progress_ < .5 ? draw_frame::over(in, out) : draw_frame::over(out, in);
+                } else {
+                    // Zoom through the outgoing picture, reveal the incoming at full frame.
+                    auto& x                     = out.transform().image_transform;
+                    x.enable_geometry_modifiers = true;
+                    double scale                = 1 + 3 * progress_;
+                    x.fill_scale                = {scale, scale};
+                    x.fill_translation          = {(1 - scale) / 2, (1 - scale) / 2};
+                    x.opacity *= 1 - progress_;
+                    result = draw_frame::over(in, out);
+                }
+            }
+        }
+        if (!manual_ && field != video_field::b && current_ < duration_)
+            ++current_;
+        if (background_ != frame_producer::empty()) {
+            auto backdrop = background_->receive(field, samples);
+            if (!backdrop)
+                backdrop = background_->last_frame(field);
+            backdrop                                              = draw_frame::push(backdrop);
+            backdrop.transform().audio_transform.volume           = 0;
+            backdrop.transform().audio_transform.immediate_volume = true;
+            result                                                = draw_frame::over(backdrop, result);
+        }
+        last_ = result;
+        return result;
+    }
+    std::future<std::wstring> call(const std::vector<std::wstring>& params) override
+    {
+        std::vector<std::wstring> tokens;
+        for (auto& part : params) {
+            std::wistringstream s(part);
+            std::wstring        v;
+            while (s >> v)
+                tokens.push_back(v);
+        }
+        if (tokens.size() == 2 && boost::to_upper_copy(tokens[0]) == L"BACKGROUND") {
+            auto producer = deps_.producer_registry->create_producer(deps_, producer_args(background_spec(tokens[1])));
+            std::lock_guard<std::mutex> lock(mutex_);
+            pending_background_ = producer;
+            return make_ready_future(std::wstring(L"OK"));
+        }
+        if(tokens.size()==4&&boost::to_upper_copy(tokens[0])==L"A_GAIN"&&boost::to_upper_copy(tokens[2])==L"B_GAIN"){
+            size_t usedA=0,usedB=0;
+            const double a=bounded(std::stod(tokens[1],&usedA),0,1),b=bounded(std::stod(tokens[3],&usedB),0,1);
+            if(usedA!=tokens[1].size()||usedB!=tokens[3].size())CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Invalid mix gain"));
+            std::lock_guard<std::mutex> lock(mutex_);gain_a_=a;gain_b_=b;return make_ready_future(std::wstring(L"OK"));
+        }
+        if (tokens.size() != 2 || boost::to_upper_copy(tokens[0]) != L"PROGRESS")
+            CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"DME CALL requires PROGRESS value"));
+        size_t consumed = 0;
+        double p        = std::stod(tokens[1], &consumed);
+        if (consumed != tokens[1].size())
+            CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME progress"));
+        bounded(p, 0, 1);
+        std::lock_guard<std::mutex> lock(mutex_);
+        manual_   = true;
+        progress_ = p;
+        return make_ready_future(std::wstring(L"OK"));
+    }
+    std::wstring   name() const override { return L"native-dme"; }
+    std::wstring   print() const override { return L"native-dme[" + effect_ + L"]"; }
+    monitor::state state() const override { return {}; }
+};
+} // namespace
+spl::shared_ptr<frame_producer> create_dme_transition(const frame_producer_dependencies&     deps,
+                                                      const spl::shared_ptr<frame_producer>& dst,
+                                                      const std::vector<std::wstring>&       params)
+{
+    for (size_t i = 0; i < params.size(); ++i)
+        if (boost::to_upper_copy(params[i]) == L"DMENATIVE") {
+            if (i + 2 >= params.size())
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"DMENATIVE needs duration and effect"));
+            size_t used     = 0;
+            int    duration = std::stoi(params[i + 1], &used);
+            if (used != params[i + 1].size() || duration < 1 || duration > 10000)
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME duration"));
+            auto effect = boost::to_upper_copy(params[i + 2]);
+            bool sony=false;
+            if(effect.find(L"SONY_")==0){size_t end=0;auto code=std::stoi(effect.substr(5),&end);sony=end==effect.size()-5&&sony_primitive(code);if(!sony&&sony_dme::reserved(code))CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Sony DME preset pending implementation"));}
+            if (!sony && effect != L"NAM" && effect != L"SUPER_MIX" && effect != L"MOVE" && effect != L"CUBE" && effect != L"ZOOM" && effect != L"PAGE_CURL" &&
+                effect != L"PAGE_ROLL" && effect != L"PUSH_LEFT" && effect != L"PUSH_RIGHT" && effect != L"PUSH_TOP" &&
+                effect != L"PUSH_BOTTOM" && effect != L"SLIDE_LEFT" && effect != L"SLIDE_RIGHT" &&
+                effect != L"SLIDE_TOP" && effect != L"SLIDE_BOTTOM")
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Unknown native DME effect"));
+            bool         manual = false, reverse = false;
+            double gain_a=1,gain_b=1;
+            std::wstring manifest, backdrop;
+            for (size_t j = i + 3; j < params.size(); j += 2) {
+                if (j + 1 >= params.size())
+                    CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Missing DME option"));
+                auto option = boost::to_upper_copy(params[j]);
+                if(option==L"A_GAIN"||option==L"B_GAIN"){size_t end=0;double value=std::stod(params[j+1],&end);if(end!=params[j+1].size())CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Invalid mix gain"));bounded(value,0,1);(option==L"A_GAIN"?gain_a:gain_b)=value;}
+                else if (option == L"MANUAL") {
+                    if (params[j + 1] != L"0" && params[j + 1] != L"1")
+                        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME manual flag"));
+                    manual = params[j + 1] == L"1";
+                } else if (option == L"REVERSE") {
+                    if (params[j + 1] != L"0" && params[j + 1] != L"1")
+                        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid DME reverse flag"));
+                    reverse = params[j + 1] == L"1";
+                } else if (option == L"BACKGROUND")
+                    backdrop = params[j + 1];
+                else if (option == L"SCENE")
+                    manifest = params[j + 1];
+                else
+                    CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Unknown DME option"));
+            }
+            return spl::make_shared<dme_transition>(deps, dst, effect, duration, manual, reverse, manifest, backdrop,gain_a,gain_b);
+        }
+    return frame_producer::empty();
+}
