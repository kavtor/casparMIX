diff --git a/src/core/producer/wipe/sony_wipe_producer.cpp b/src/core/producer/wipe/sony_wipe_producer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fe3ef327cc1220d60cc2e840b96cae29339512c0
--- /dev/null
+++ b/src/core/producer/wipe/sony_wipe_producer.cpp
@@ -0,0 +1,310 @@
+// Native GPU wipe matte producer for verified Sony panel pattern numbers.
+#include "sony_wipe_producer.h"
+#include <core/producer/color/color_producer.h>
+#include <core/frame/frame_transform.h>
+#include <common/future.h>
+#include <common/param.h>
+#include <boost/algorithm/string/predicate.hpp>
+#include <cmath>
+#include <mutex>
+#include <sstream>
+
+namespace caspar::core {
+namespace {
+class sony_wipe_producer final : public frame_producer
+{
+    draw_frame white_;
+    sony_wipe wipe_;
+    std::mutex mutex_;
+    int duration_ = 0;
+    int current_ = 0;
+
+    static double number(const std::wstring& value, double low, double high)
+    {
+        size_t end = 0;
+        const auto result = std::stod(value, &end);
+        if (end != value.size() || !std::isfinite(result) || result < low || result > high)
+            CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid native wipe value"));
+        return result;
+    }
+
+    void update(const std::vector<std::wstring>& params)
+    {
+        auto next = wipe_;
+        auto duration = duration_;
+        bool manual = false;
+        for (size_t i=0; i<params.size(); ++i) {
+            auto key = boost::to_upper_copy(params[i]);
+            if (i+1 >= params.size())
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Missing native wipe value"));
+            const auto value = params[++i];
+            if (key == L"PROGRESS") { next.progress = number(value,0,1); manual = true; }
+            else if(key==L"DUST_RATIO") next.dust_ratio=number(value,0,1);
+            else if(key==L"H_SIZE") next.dust_h_size=number(value,.001,1);
+            else if(key==L"V_SIZE") next.dust_v_size=number(value,.001,1);
+            else if(key==L"FLASH_RATE") next.dust_flash=number(value,0,100);
+            else if (key == L"SOFT") next.soft = number(value,0,100);
+            else if(key==L"BORDER_SIDE"){double side=number(value,-1,1);if(side!=std::floor(side))CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"BORDER_SIDE must be -1, 0 or 1"));next.border_side=int(side);}
+            else if(key==L"INNER_SOFT")next.inner_soft=number(value,-1,100);
+            else if(key==L"OUTER_SOFT")next.outer_soft=number(value,-1,100);
+            else if (key == L"BORDER") next.border = number(value,0,100);
+            else if (key == L"ASPECT") next.aspect = number(value,0.01,1000);
+            else if(key==L"TILESIZE"){auto size=number(value,2,50);if(size!=std::floor(size))CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"TILESIZE must be an integer"));next.tile_size=int(size);}
+            else if(key==L"ROUNDING") next.rounding=number(value,0,50);
+            else if(key==L"VERTICES"){auto count=number(value,3,64);if(count!=std::floor(count))CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"VERTICES must be an integer"));next.vertices=int(count);}
+            else if (key == L"MULTI") {
+                auto count = number(value,1,16);
+                if (count != std::floor(count) || (count!=1 && count!=2 && count!=4 && count!=9 && count!=16))
+                    CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"MULTI must be 1, 2, 4, 9 or 16"));
+                next.multi = static_cast<int>(count);
+            } else if (key == L"X") next.x = number(value,0,1);
+            else if (key == L"Y") next.y = number(value,0,1);
+            else if (key == L"REVERSE") {
+                const auto flag = number(value,0,1);
+                if (flag != 0 && flag != 1)
+                    CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"REVERSE must be 0 or 1"));
+                next.reverse = flag == 1;
+            }
+            else if (key == L"DURATION") {
+                auto frames = number(value,1,10000);
+                if (frames != std::floor(frames))
+                    CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"DURATION must be an integer frame count"));
+                duration = static_cast<int>(frames);
+            } else CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Unknown native wipe parameter: " + key));
+        }
+        wipe_ = next;
+        duration_ = manual ? 0 : duration;
+    }
+
+    draw_frame snapshot() const
+    {
+        auto result = draw_frame::push(white_);
+        result.transform().image_transform.wipe = wipe_;
+        return result;
+    }
+  public:
+    sony_wipe_producer(const frame_producer_dependencies& deps, int code, const std::vector<std::wstring>& params)
+        : white_(create_color_frame(this, deps.frame_factory, uint32_t(0xffffffff)))
+    {
+        wipe_.code = code;
+        wipe_.output_aspect=double(deps.format_desc.square_width)/double(deps.format_desc.square_height);
+        update(params);
+    }
+    draw_frame frame_at(double progress) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        wipe_.progress=progress;
+        duration_=0;
+        return snapshot();
+    }
+    draw_frame receive_impl(video_field field, int) override
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (duration_ > 0 && field != video_field::b) {
+            wipe_.progress = duration_ == 1 ? 1.0 : std::min(1.0,double(current_)/double(duration_-1));
+            if (field != video_field::b && duration_ > 0 && current_ < duration_) ++current_;
+        }
+        return snapshot();
+    }
+    draw_frame first_frame(video_field) override
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return snapshot();
+    }
+    draw_frame last_frame(video_field field) override { return first_frame(field); }
+    std::future<std::wstring> call(const std::vector<std::wstring>& params) override
+    {
+        std::vector<std::wstring> tokens;
+        for (const auto& part : params) {
+            std::wistringstream stream(part);
+            for (std::wstring token; stream >> token;) tokens.push_back(token);
+        }
+        std::lock_guard<std::mutex> lock(mutex_);
+        update(tokens);
+        return make_ready_future(std::wstring(L"OK"));
+    }
+    uint32_t nb_frames() const override { return duration_ > 0 ? duration_ : UINT32_MAX; }
+    bool is_ready() override { return true; }
+    std::wstring name() const override { return L"sony-wipe"; }
+    std::wstring print() const override { return L"sony-wipe"; }
+    monitor::state state() const override
+    {
+        // Producer calls run on the stage executor; the snapshot is immutable.
+        monitor::state result;
+        return result;
+    }
+};
+}
+
+namespace {
+uint32_t opaque_colour_value(const std::wstring& colour)
+{
+    uint32_t value;
+    if (!try_get_color(colour,value) || (value >> 24) != 0xff)
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"BORDERCOLOR requires an opaque colour"));
+    return value;
+}
+
+class sony_wipe_transition final : public frame_producer
+{
+    spl::shared_ptr<frame_producer> destination_;
+    spl::shared_ptr<frame_producer> source_ = frame_producer::empty();
+    spl::shared_ptr<sony_wipe_producer> mask_;
+    uint32_t colour_value_;
+    draw_frame colour_;
+    spl::shared_ptr<frame_factory> frame_factory_;
+    int duration_;
+    int current_ = 0;
+    double progress_ = 0;
+    bool manual_;
+    bool draw_border_;
+    bool ready_ = false;
+
+  public:
+    sony_wipe_transition(const frame_producer_dependencies& deps,
+        const spl::shared_ptr<frame_producer>& destination,
+        const spl::shared_ptr<frame_producer>& mask, int duration, bool manual, bool draw_border, const std::wstring& colour)
+        : destination_(destination), mask_(spl::dynamic_pointer_cast<sony_wipe_producer>(mask)),
+          colour_value_(opaque_colour_value(colour)), colour_(create_color_frame(this,deps.frame_factory,colour_value_)),
+          frame_factory_(deps.frame_factory), duration_(duration), manual_(manual), draw_border_(draw_border) {}
+    void leading_producer(const spl::shared_ptr<frame_producer>& source) override { source_ = source; }
+    draw_frame first_frame(video_field field) override { return destination_->first_frame(field); }
+    bool is_ready() override { return destination_->is_ready(); }
+    spl::shared_ptr<frame_producer> following_producer() const override
+    {
+        return !manual_ && ready_ && current_ >= duration_ ? destination_ : frame_producer::empty();
+    }
+    draw_frame receive_impl(video_field field, int nb_samples) override
+    {
+        destination_->first_frame(field);
+        ready_ = destination_->is_ready();
+        if (!ready_) return source_->receive(field,nb_samples);
+        if (!manual_ && field != video_field::b) progress_ = duration_ == 1 ? 1 : std::min(1.0,double(current_)/double(duration_-1));
+        // Frame-local progress never needs AMCP tokenization, a future or string conversion.
+        auto mask = mask_->frame_at(progress_);
+        auto incoming = destination_->receive(field,nb_samples);
+        if (!incoming) incoming = destination_->last_frame(field);
+        auto outgoing = source_->receive(field,nb_samples);
+        if (!outgoing) outgoing = source_->last_frame(field);
+        outgoing.transform().audio_transform.volume *= 1-progress_;
+        incoming.transform().audio_transform.volume *= progress_;
+        if (draw_border_) {
+            // Incoming video and the contour share the exact same frame-local
+            // distance field. No independently clocked overlay producer exists.
+            auto key = mask;
+            key.transform().image_transform.wipe.role = 1;
+            auto result = draw_frame::over(outgoing,draw_frame::mask(incoming,key));
+            if (mask.transform().image_transform.wipe.border > 0) {
+                auto border = draw_frame::push(colour_);
+                border.transform().image_transform.wipe = mask.transform().image_transform.wipe;
+                border.transform().image_transform.wipe.role = 2;
+                result = draw_frame::over(result,border);
+            }
+            if (!manual_ && field != video_field::b && current_ < duration_) ++current_;
+            return result;
+        }
+        auto key_in = draw_frame::push(mask);
+        auto key_out = draw_frame::push(mask);
+        for (auto* key : {&key_in,&key_out}) {
+            key->transform().image_transform.enable_geometry_modifiers = true;
+            key->transform().image_transform.fill_scale = {2.0,1.0};
+        }
+        key_out.transform().image_transform.fill_translation = {-1.0,0.0};
+        if (!manual_ && field != video_field::b && current_ < duration_) ++current_;
+        return draw_frame::over(colour_,draw_frame::over(draw_frame::mask(outgoing,key_out),draw_frame::mask(incoming,key_in)));
+    }
+    std::future<std::wstring> call(const std::vector<std::wstring>& params) override
+    {
+        std::vector<std::wstring> tokens;
+        for (const auto& part : params) {
+            std::wistringstream stream(part);
+            for(std::wstring token;stream>>token;) tokens.push_back(token);
+        }
+        // Validate every option before committing any picture/state change.
+        auto colour = colour_;
+        auto colour_value = colour_value_;
+        std::vector<std::wstring> matte_tokens;
+        for(size_t i=0;i<tokens.size();i+=2) {
+            if(i+1>=tokens.size())
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Missing native wipe value"));
+            if(boost::iequals(tokens[i],L"BORDERCOLOR")) {
+                uint32_t value;
+                if(!try_get_color(tokens[i+1],value) || (value>>24)!=0xff)
+                    CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"BORDERCOLOR requires an opaque colour"));
+                if(value!=colour_value) {colour=create_color_frame(this,frame_factory_,value);colour_value=value;}
+            } else { matte_tokens.push_back(tokens[i]);matte_tokens.push_back(tokens[i+1]); }
+        }
+        mask_->call(matte_tokens).get();
+        colour_ = colour;
+        colour_value_ = colour_value;
+        for (size_t i=0;i+1<tokens.size();i+=2)
+            if(boost::iequals(tokens[i],L"PROGRESS")) { progress_=std::stod(tokens[i+1]);manual_=true; }
+        return make_ready_future(std::wstring(L"OK"));
+    }
+    std::wstring name() const override { return L"transition"; }
+    std::wstring print() const override { return L"sony-wipe-transition"; }
+    monitor::state state() const override
+    {
+        monitor::state result;
+        result["transition/type"] = "sony-wipe";
+        result["transition/frame"] = {current_,duration_};
+        return result;
+    }
+};
+}
+
+spl::shared_ptr<frame_producer> create_sony_wipe_producer(
+    const frame_producer_dependencies& dependencies, const std::vector<std::wstring>& params)
+{
+    if(!params.empty()&&boost::iequals(params[0],L"WIPE://DUSTMIX"))
+        return spl::make_shared<sony_wipe_producer>(dependencies,274,std::vector<std::wstring>(params.begin()+1,params.end()));
+    if (params.empty() || !boost::istarts_with(params[0], L"WIPE://SONY/")) return frame_producer::empty();
+    const auto text = params[0].substr(12);
+    size_t end = 0;
+    const auto code = std::stoi(text, &end);
+    // TODO: Sony karaoke 220-223, undecoded matrix paths 224-247,
+    // random presets 270-272, dynamic random matrix 273 and diamond dust 274.
+    // Their IDs are reserved; never substitute another mask for these patterns.
+    if((code>=220&&code<=247)||(code>=270&&code<=274))
+        CASPAR_THROW_EXCEPTION(user_error()<<msg_info(L"Sony wipe pattern pending implementation"));
+    if (end != text.size() || (!(code>=1 && code<=24) && code!=26 && code!=27 && code!=29 && code!=49 && !(code>=100&&code<=107) && !(code>=200&&code<=203) && !(code>=250&&code<=257) && !(code>=260&&code<=269) && !(code>=206&&code<=213) && code!=150 && code!=151 && code!=156 && code!=158 && code!=160 && code!=162 && code!=516 && code!=518 && code!=604 && code!=606 && code!=624 && code!=661 && !(code>=300&&code<=304)))
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Unsupported Sony wipe pattern"));
+    return spl::make_shared<sony_wipe_producer>(dependencies, code,
+        std::vector<std::wstring>(params.begin()+1,params.end()));
+}
+spl::shared_ptr<frame_producer> create_sony_wipe_transition(
+    const frame_producer_dependencies& deps, const spl::shared_ptr<frame_producer>& destination,
+    const std::vector<std::wstring>& params)
+{
+    auto it = std::find_if(params.begin(),params.end(),[](const auto& p){return boost::iequals(p,L"WIPESONY")||boost::iequals(p,L"DUSTMIX");});
+    if (it == params.end()) return frame_producer::empty();
+    const bool dust=boost::iequals(*it,L"DUSTMIX");
+    auto options = std::vector<std::wstring>(it+1,params.end());
+    if(dust&&!options.empty())options.insert(options.begin()+1,{L"SONY",L"274"});
+    if (options.size()<3 || !boost::iequals(options[1],L"SONY"))
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Use WIPESONY FRAMES SONY CODE"));
+    size_t end = 0;
+    int duration = std::stoi(options[0],&end);
+    if(end != options[0].size() || duration < 1 || duration > 10000)
+        CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Invalid native wipe duration"));
+    std::vector<std::wstring> mask_params{dust?L"WIPE://DUSTMIX":L"WIPE://SONY/"+options[2]};
+    bool manual = false;
+    bool draw_border = true;
+    std::wstring colour = L"#ffffff";
+    for(size_t i=3;i<options.size();i+=2) {
+        if(i+1>=options.size()) CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"Missing native wipe value"));
+        if(boost::iequals(options[i],L"MANUAL")) {
+            if(options[i+1]!=L"0" && options[i+1]!=L"1")
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"MANUAL must be 0 or 1"));
+            manual = options[i+1]==L"1";
+        } else if(boost::iequals(options[i],L"BORDERMODE")) {
+            if (!boost::iequals(options[i+1],L"DRAW") && !boost::iequals(options[i+1],L"GAP"))
+                CASPAR_THROW_EXCEPTION(user_error() << msg_info(L"BORDERMODE must be DRAW or GAP"));
+            draw_border = boost::iequals(options[i+1],L"DRAW");
+        } else if(boost::iequals(options[i],L"BORDERCOLOR")) colour=options[i+1];
+        else { mask_params.push_back(options[i]);mask_params.push_back(options[i+1]); }
+    }
+    auto mask = create_sony_wipe_producer(deps,mask_params);
+    return spl::make_shared<sony_wipe_transition>(deps,destination,mask,duration,manual,draw_border,colour);
+}
+
+}
