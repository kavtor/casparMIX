 }
 
+uniform int sony_border_side;
+uniform float sony_inner_soft,sony_outer_soft;
 float sony_matte(vec2 packed_uv)
 {
     bool outgoing = packed_uv.x >= 0.5;
@@ -852,8 +854,13 @@ float sony_matte(vec2 packed_uv)
     float soft=mosaic?min(sony_soft,sony_tile_size*.5):sony_soft;
     float border=mosaic?min(sony_border,sony_tile_size*.5):sony_border;
     if (sony_role == 1) return sony_coverage(d, soft);
-    float inner = sony_coverage(d-border, soft);
-    float outer = sony_coverage(d+border, soft);
+    float inner_width=sony_border_side==1?0.0:sony_border_side==-1?2.0*border:border;
+    float outer_width=sony_border_side==-1?0.0:sony_border_side==1?2.0*border:border;
+    float inner_soft=sony_inner_soft<0.0?soft:sony_inner_soft;
+    float outer_soft=sony_outer_soft<0.0?soft:sony_outer_soft;
+    float inner = sony_coverage(d-inner_width, inner_soft);
+    // Different softness can cross; preserve an ordered partition of A/color/B.
+    float outer = max(inner,sony_coverage(d+outer_width, outer_soft));
     if (sony_role == 2) return clamp(outer-inner, 0.0, 1.0);
     return outgoing ? (inner >= 1.0 ? 0.0 : clamp((1.0-outer)/(1.0-inner),0.0,1.0)) : inner;
 }
