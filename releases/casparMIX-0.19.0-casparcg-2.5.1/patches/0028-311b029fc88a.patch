+        auto& incoming=b.transform().image_transform;incoming.enable_geometry_modifiers=true;
+        incoming.fill_scale={horizontal?t:1,vertical?t:1};
+        incoming.fill_translation={horizontal?(v[0]<0?0:v[0]>0?1-t:(1-t)/2):0,vertical?(v[1]<0?0:v[1]>0?1-t:(1-t)/2):0};
+        if(code>=2621){auto& outgoing=a.transform().image_transform;outgoing.enable_geometry_modifiers=true;outgoing.fill_scale={horizontal?1-t:1,vertical?1-t:1};outgoing.fill_translation={horizontal?(v[0]<0?t:0):0,vertical?(v[1]<0?t:0):0};}
+        return draw_frame::over(a,b);
+    }
+    if(code>=1011&&code<=1013){
+        std::vector<draw_frame> pieces;const int count=code==1013?4:2;
+        for(int i=0;i<count;++i){auto piece=draw_frame::push(a);auto& x=piece.transform().image_transform;x.enable_geometry_modifiers=true;
+            const bool horizontal=code!=1012,vertical=code!=1011;
+            const bool right=code==1013?(i%2)!=0:i!=0,bottom=code==1013?i>=2:i!=0;
+            const double dx=horizontal?(right?.5*t:-.5*t):0,dy=vertical?(bottom?.5*t:-.5*t):0;
+            x.fill_translation={dx,dy};x.clip_translation={(horizontal&&right?.5:0)+dx,(vertical&&bottom?.5:0)+dy};x.clip_scale={horizontal?.5:1,vertical?.5:1};
+            // The video is split into multiple draws, not multiple audio feeds.
+            if(i>0)piece.transform().audio_transform.volume=0;
+            pieces.push_back(std::move(piece));
+        }
+        auto result=b;for(auto& piece:pieces)result=draw_frame::over(result,piece);return result;
+    }
+    if(code==1384||code==1385){
+        auto result=a;constexpr int strips=16;
+        for(int i=0;i<strips;++i){auto piece=draw_frame::push(b);auto& x=piece.transform().image_transform;x.enable_geometry_modifiers=true;
+            const double offset=(i%2?1:-1)*(1-t),start=double(i)/strips;
+            const bool horizontal=code==1384;
+            x.fill_translation={horizontal?offset:0,horizontal?0:offset};
+            x.clip_translation={horizontal?offset:start,horizontal?start:offset};
+            x.clip_scale={horizontal?1:1.0/strips,horizontal?1.0/strips:1};
+            if(i>0)piece.transform().audio_transform.volume=0;
+            result=draw_frame::over(result,piece);
+        }
+        return result;
+    }
+    // Four edge-hinged doors: live texture is projected, never masked in place.
+    const int i=code-1041;const bool horizontal=i<2;const double hinge=i==1||i==3?1:0;
