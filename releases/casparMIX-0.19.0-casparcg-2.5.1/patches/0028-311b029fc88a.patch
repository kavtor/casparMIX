+    auto& x=b.transform().image_transform;x.enable_geometry_modifiers=true;
+    std::array<double,2>* corners[]={&x.perspective.ul,&x.perspective.ur,&x.perspective.lr,&x.perspective.ll};
+    const double xs[]={0,1,1,0},ys[]={0,0,1,1};
+    for(int point=0;point<4;++point){double px=(xs[point]-.5)*aspect,py=ys[point]-.5;
+        const double offset=(horizontal?xs[point]:ys[point])-hinge;
+        const double z=std::abs(offset)*(horizontal?aspect:1)*std::sin(angle);
+        if(horizontal)px=((hinge-.5)+offset*std::cos(angle))*aspect;
+        else py=(hinge-.5)+offset*std::cos(angle);
+        const double scale=camera/(camera-z);*corners[point]={.5+px*scale/aspect,.5+py*scale};
+    }
+    return draw_frame::over(a,b);
