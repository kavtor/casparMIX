+// Dust Mix is an explicit project transition, not a Sony 274 catalogue claim.
+uniform float dust_ratio,dust_flash;
+uniform vec2 dust_size;
+float dust_hash(vec2 cell,float phase) {
+    return fract(sin(dot(cell,vec2(127.1,311.7))+phase*74.7)*43758.5453);
+}
+float dust_coverage(vec2 p,float progress) {
+    vec2 physical=vec2(p.x*sony_output_aspect,p.y);
+    vec2 uv=physical/max(dust_size,vec2(.001));
+    vec2 cell=floor(uv),local=fract(uv)-vec2(.5);
+    // Progress-indexed flashing retraces deterministically and stops with T-bar.
+    float phase=floor(progress*dust_flash);
+    float start=dust_hash(cell,phase)*.8;
+    float radius=clamp((progress-start)/(1.0-start),0.0,1.0);
+    float diamond=abs(local.x)+abs(local.y);
+    float aa=max(fwidth(diamond),.001);
+    float coverage=smoothstep(diamond-aa,diamond+aa,radius);
+    return mix(progress,coverage,dust_ratio);
+}
